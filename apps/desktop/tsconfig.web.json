{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "test/setup.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/renderer/src/*"
      ],
      "partial-tsx": ["../../packages/views/rich-content/partial-tsx.d.ts"],
      "partial-react": ["../../packages/views/rich-content/partial-react.d.ts"],
      "partial-react/import-map": ["../../packages/views/rich-content/partial-react-import-map.d.ts"],
      "partial-react/remote-module": ["../../packages/views/rich-content/partial-react-remote-module.d.ts"]
    }
  }
}
